{
  "name": "thehacode",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:lint": "supabase db lint",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "mkdir -p src/types && supabase gen types typescript --local --schema public > src/types/database.ts"
  },
  "dependencies": {
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "i18next": "^25.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
