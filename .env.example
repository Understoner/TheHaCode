EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=staging

# Anmeldung ueber Google/Apple: kommagetrennte Liste der Anbieter, die im
# Formular angeboten werden. Leer lassen, solange sie in Supabase nicht
# eingeschaltet UND mit Zugangsdaten hinterlegt sind - sonst landet der Nutzer
# beim Klick auf einer Supabase-Fehlerseite (siehe src/features/auth/oauth.ts).
EXPO_PUBLIC_AUTH_PROVIDERS=
